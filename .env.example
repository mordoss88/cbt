# Cloud backup (optional). Copy to .env.local for local dev, and add the same two values to the
# EAS "preview" environment for builds and updates (see README). Both are public by design:
# row level security protects the data, and the backup is encrypted on the phone anyway.
# Never put the database password or a secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
